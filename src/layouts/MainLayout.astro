---
import PageLoader from "@/components/PageLoader.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
interface Props { content?: { title?: string; code?: string }; showNav?: boolean }
const { content = {} } = Astro.props;
---
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="Tu próxima gran carta empieza con un sobre. Explora colecciones de Magic, todas sus impresiones y precios por acabado." />
        <link rel="preconnect" href="https://cards.scryfall.io" />
        <ClientRouter />
        <title>{content.title ?? "MTG Top Picks"}</title>
        <link rel="icon" href="/mtg-top-picks.png" />
    </head>
    <body class="app-theme">
        <a href="#contenido" class="skip-link">Saltar al contenido</a>
        <header class="site-header">
            <div class="site-header-inner">
                <a href="/sets/1" class="brand" aria-label="MTG Top Picks, inicio">
                    <span class="brand-mark" aria-hidden="true">✦</span>
                    <span>MTG <strong>TOP PICKS</strong><small>THE BOOSTER COLLECTION</small></span>
                </a>
                <nav aria-label="Navegación principal" class="site-nav"><a href="/sets/1" aria-current={!content.code ? "page" : undefined}>Colecciones</a>{content.code && <span class="code-chip">{content.code}</span>}</nav>
                <span class="header-caption"><i></i> El multiverso, a tu alcance</span>
            </div>
        </header>
        <div id="contenido" tabindex="-1"><slot /></div>
        <footer class="site-footer">
            <a href="/sets/1" class="footer-brand">✦ MTG TOP PICKS</a>
            <div><p>Imágenes y precios de <a href="https://scryfall.com">Scryfall</a> · sobres de <a href="https://mtgjson.com">MTGJSON</a>.</p><p>Precios orientativos en USD. Proyecto independiente de Wizards of the Coast.</p></div>
            <span class="footer-note">Hecho para quienes coleccionan.</span>
        </footer>
        <PageLoader />
    </body>
</html>
