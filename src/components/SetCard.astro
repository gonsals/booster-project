---
import type { CatalogSet } from "@/lib/setList";
interface Props { set: CatalogSet }
const { set } = Astro.props;
const labels = { play: "Play", draft: "Draft", set: "Set", collector: "Collector", jumpstart: "Jumpstart", theme: "Theme", other: "Especial" };
const release = new Intl.DateTimeFormat("es", { dateStyle: "medium", timeZone: "UTC" }).format(new Date(`${set.releaseDate}T00:00:00Z`));
const typeLabels: Record<string, string> = { expansion: "Expansión", core: "Edición básica", masters: "Masters", draft_innovation: "Edición especial", funny: "Un-set", commander: "Commander", promo: "Promocional" };
const hue = [...set.code].reduce((n, char) => n + char.charCodeAt(0), 0) % 5;
---
<article class={`set-card palette-${hue}`} data-set-code={set.code}>
    <div class="set-card-top"><span class="set-emblem" aria-hidden="true">✦</span><span class="set-code">{set.code}</span><span class={`release-status ${set.isUpcoming ? "upcoming" : "available"}`}>{set.isUpcoming ? "Próximamente" : "Disponible"}</span></div>
    <p class="set-category">{typeLabels[set.type] ?? "Colección"}</p>
    <h2><a href={`/sets/boosters/${set.code}`} class="set-link" transition:name={`set-title-${set.code}`}>{set.name}</a></h2>
    <p class="set-release"><time datetime={set.releaseDate}>{release}</time>{set.isUpcoming && <span> · Vista previa</span>}</p>
    <div class="set-card-bottom"><div class="booster-tags">{Object.entries(labels).filter(([key]) => set.boosters[key as keyof typeof labels]).map(([key, label]) => <span class={`booster-tag ${key === "collector" ? "collector-tag" : ""}`}>{label}</span>)}</div><span class="set-arrow" aria-hidden="true">↗</span></div>
</article>
