<div id="page-loader" class="page-loading hidden" role="status" aria-live="polite" aria-label="Cargando página">
    <div class="loading-panel">
        <div class="loading-pack" aria-hidden="true"><span class="loading-card card-left">✧</span><span class="loading-card card-right">✧</span><span class="pack-front"><small>MTG TOP PICKS</small><b>✦</b><em>YOUR NEXT PULL</em></span><span class="pack-glow"></span></div>
        <p class="loading-eyebrow">Cada sobre, una posibilidad</p><h2 id="loading-title">Preparando tu sobre</h2><p id="loading-copy">Buscando las cartas que pueden tocarte…</p>
        <div class="loading-track" aria-hidden="true"><span></span></div>
        <p class="loading-hint">Las próximas consultas reutilizan las cartas ya cargadas.<span id="loading-elapsed" aria-hidden="true"></span></p>
    </div>
</div>
<script>
    let timer: ReturnType<typeof setInterval> | undefined;
    let started = 0;
    let generation = 0;
    const hide = () => {
        clearInterval(timer);
        document.getElementById("page-loader")?.classList.add("hidden");
        document.getElementById("contenido")?.removeAttribute("aria-busy");
        document.getElementById("contenido")?.removeAttribute("inert");
    };
    document.addEventListener("astro:before-preparation", event => {
        const transition = event as Event & { to: URL; loader: () => Promise<void> };
        const cards = transition.to.pathname.includes("/sets/boosters/");
        const loader = document.getElementById("page-loader");
        if (!loader) return;
        loader.classList.remove("hidden");
        document.getElementById("contenido")?.setAttribute("aria-busy", "true");
        document.getElementById("contenido")?.setAttribute("inert", "");
        const activeGeneration = ++generation;
        document.getElementById("loading-title")!.textContent = cards ? "Preparando tu sobre" : "Explorando colecciones";
        document.getElementById("loading-copy")!.textContent = cards ? "Buscando las cartas que pueden tocarte…" : "Actualizando tu selección…";
        document.getElementById("loading-elapsed")!.textContent = "";
        started = Date.now(); clearInterval(timer);
        let longMessage = false;
        timer = setInterval(() => {
            const seconds = Math.floor((Date.now() - started) / 1000);
            const elapsed = document.getElementById("loading-elapsed");
            if (elapsed) elapsed.textContent = ` · ${seconds} s`;
            if (seconds >= 8 && !longMessage) {
                longMessage = true;
                const copy = document.getElementById("loading-copy");
                if (copy) copy.textContent = "La primera consulta de una colección grande puede tardar un poco más. Seguimos cargando…";
            }
        }, 1000);
        const original = transition.loader;
        transition.loader = async () => { try { await original(); } finally { if (activeGeneration === generation) hide(); } };
    });
    document.addEventListener("astro:after-swap", hide);
    document.addEventListener("astro:page-load", hide);
    window.addEventListener("pageshow", hide);
    window.addEventListener("pagehide", hide);
</script>
